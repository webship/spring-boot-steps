{
  "name": "@webship-js/spring-boot-steps",
  "version": "2.0.1",
  "description": "Cucumber step definitions for what Spring Boot and Spring Security give every app, a plugin for webship-js (Playwright and Cucumber): the generated login and logout pages and their refusals, remember-me and a session that ended, the redirect to the login page and back, the access-denied answer of a role rule, a CSRF refusal, the default error page and an app's own error page, the health endpoint and the details it shows by role, and the validation messages and flash messages of server-rendered forms.",
  "main": "tests/step-definitions/spring-boot-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "tests/new-app/",
    "tests/without-security/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "spring-boot",
    "spring-security",
    "java",
    "login",
    "csrf",
    "error-page",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/spring-boot-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/spring-boot-steps/issues"
  },
  "homepage": "https://github.com/webship/spring-boot-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
